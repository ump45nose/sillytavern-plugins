[Unit]
Description=Start NAS containers in dependency order
Requires=docker.service
After=docker.service
PartOf=docker.service
RequiresMountsFor=/vol2/1000/Docker

[Service]
Type=oneshot
User=yuwk
Group=Users
ExecStart=/bin/bash /home/yuwk/cron/scripts/compose-autostart.sh
Restart=on-failure
RestartSec=30s
TimeoutStartSec=0

[Install]
WantedBy=docker.service
