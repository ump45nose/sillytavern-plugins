[Unit]
Description=CodexHost agent server
StartLimitIntervalSec=300
StartLimitBurst=3
[Service]
Type=forking
WorkingDirectory=%h
EnvironmentFile=%h/.config/nas-resource-governance/codex.env
Environment=CODEX_HOME=%h/.codex
ExecStart=/opt/node-v22.23.2-linux-x64/bin/codexhost remote start
ExecStop=/opt/node-v22.23.2-linux-x64/bin/codexhost remote stop
Restart=on-failure
RestartSec=10
Slice=codex.slice
OOMPolicy=kill
KillMode=control-group
TimeoutStartSec=30
TimeoutStopSec=15
[Install]
WantedBy=default.target
