FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends build-essential git \
    && git clone --depth 1 https://github.com/JoeanAmier/XHS-Downloader.git /app \
    && cd /app && git fetch --depth 1 origin 47840a1bee8438324ff10753c4291148c46071c8 \
    && git checkout --detach 47840a1bee8438324ff10753c4291148c46071c8 \
    && pip install --no-cache-dir -r requirements.txt \
    && apt-get purge -y build-essential git && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/* /root/.cache
WORKDIR /app
EXPOSE 5556
CMD ["python", "main.py", "api"]
