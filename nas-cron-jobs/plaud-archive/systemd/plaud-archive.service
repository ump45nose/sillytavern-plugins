[Unit]
Description=Plaud Archive HTTP and MCP
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hermes
Group=hermes
WorkingDirectory=/vol1/1000/Code/personal-info/plaud-archive
EnvironmentFile=/home/yuwk/.config/plaud-archive/server.env
ExecStart=/vol1/1000/Code/personal-info/plaud-archive/.venv/bin/python -m plaud_archive.cli serve
Restart=on-failure
RestartSec=5
UMask=0007
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
