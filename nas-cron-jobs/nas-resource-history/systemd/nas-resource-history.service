[Unit]
Description=Record NAS pressure and process resource use
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /home/yuwk/cron/scripts/nas-resource-history.py
Group=Users
LogsDirectory=nas-resource-history
LogsDirectoryMode=0750
UMask=0027
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=20
MemoryMax=128M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
