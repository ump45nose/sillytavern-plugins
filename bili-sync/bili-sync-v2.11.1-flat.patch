+/// Persist only a missing path; a concurrent or historical assignment wins unchanged.
+async fn persist_flat_page_path(id: i32, assigned: &Path, connection: &DatabaseConnection) -> Result<String> {
+    page::Entity::update_many()
+        .col_expr(page::Column::Path, Expr::value(assigned.to_string_lossy().to_string()))
+        .filter(page::Column::Id.eq(id))
+        .filter(
+            Condition::any()
+                .add(page::Column::Path.is_null())
+                .add(page::Column::Path.eq("")),
+        )
+        .exec(connection)
+        .await?;
+    page::Entity::find_by_id(id)
+        .select_only()
+        .column(page::Column::Path)
+        .into_tuple::<Option<String>>()
+        .one(connection)
+        .await?
+        .flatten()
+        .filter(|path| !path.is_empty())
+        .context("flat path was not persisted")
+}
