+#[cfg(test)]
+mod flat_path_tests {
+    use super::*;
+    use sea_orm::{ConnectionTrait, Database};
+
+    async fn test_database() -> DatabaseConnection {
+        let connection = Database::connect("sqlite::memory:").await.unwrap();
+        connection
+            .execute_unprepared("CREATE TABLE page (id INTEGER PRIMARY KEY, path TEXT)")
+            .await
+            .unwrap();
+        connection
+            .execute_unprepared("INSERT INTO page VALUES (1, NULL), (2, ''), (3, 'legacy/../Odd title.MP4')")
+            .await
+            .unwrap();
+        connection
+    }
+
+    #[tokio::test]
+    async fn flat_path_is_committed_before_download_and_reused_on_retry() {
+        let connection = test_database().await;
+        let expected = "/downloads/UP_Title.mp4";
+        assert_eq!(
+            persist_flat_page_path(1, Path::new(expected), &connection)
+                .await
+                .unwrap(),
+            expected
+        );
+        assert_eq!(
+            persist_flat_page_path(1, Path::new("/downloads/changed.mp4"), &connection)
+                .await
+                .unwrap(),
+            expected
+        );
+        assert_eq!(
+            persist_flat_page_path(2, Path::new(expected), &connection)
+                .await
+                .unwrap(),
+            expected
+        );
+    }
+
+    #[tokio::test]
+    async fn historical_path_is_preserved_byte_for_byte() {
+        let connection = test_database().await;
+        assert_eq!(
+            persist_flat_page_path(3, Path::new("/new/path.mp4"), &connection)
+                .await
+                .unwrap(),
+            "legacy/../Odd title.MP4"
+        );
+    }
+
+    #[tokio::test]
+    async fn concurrent_path_updates_cannot_replace_the_winner() {
+        let connection = test_database().await;
+        let (left, right) = tokio::join!(
+            persist_flat_page_path(1, Path::new("/one.mp4"), &connection),
+            persist_flat_page_path(1, Path::new("/two.mp4"), &connection),
+        );
+        assert_eq!(left.unwrap(), right.unwrap());
+    }
+
+    #[tokio::test]
+    async fn missing_page_fails_before_any_download_can_start() {
+        let connection = test_database().await;
+        assert!(
+            persist_flat_page_path(999, Path::new("/one.mp4"), &connection)
+                .await
+                .is_err()
+        );
+    }
