index 0000000..3abb035
--- /dev/null
+++ b/crates/bili_sync/src/utils/flat_output.rs
@@ -0,0 +1,490 @@
+//! Durable assignments for new flat-output pages. Historical paths are never adopted.
+//!
+//! Keep `.bili-sync-flat` with the output directory: it is the reservation ledger,
+//! including assignments made just before a process crash or a failed DB write.
+use std::collections::HashSet;
+use std::fs::{self, File, OpenOptions};
+use std::io::{self, Read, Write};
+use std::path::{Component, Path, PathBuf};
+use std::sync::atomic::{AtomicU64, Ordering};
+
+const STATE_DIR: &str = ".bili-sync-flat";
+static NEXT_FILE: AtomicU64 = AtomicU64::new(0);
+
+#[derive(Clone, Debug)]
+pub struct FlatOutput {
+    pub path: PathBuf,
+}
+
+pub struct StagedFile {
+    path: PathBuf,
+}
+
+impl StagedFile {
+    pub fn path(&self) -> &Path {
+        &self.path
+    }
+}
+
+impl Drop for StagedFile {
+    fn drop(&mut self) {
+        let _ = fs::remove_file(&self.path);
+    }
+}
+
+fn component(value: &str) -> io::Result<()> {
+    let mut parts = Path::new(value).components();
+    if !matches!(parts.next(), Some(Component::Normal(_))) || parts.next().is_some() {
+        return Err(io::Error::other("invalid flat-output filename"));
+    }
+    Ok(())
+}
+
+fn read_assignment(path: &Path) -> io::Result<String> {
+    let value = fs::read_to_string(path)?;
+    component(&value)?;
+    if !value.ends_with(".mp4") {
+        return Err(io::Error::other("invalid flat-output assignment"));
+    }
+    Ok(value)
+}
+
+fn staging_file(directory: &Path) -> io::Result<(StagedFile, File)> {
+    fs::create_dir_all(directory)?;
+    loop {
+        let id = NEXT_FILE.fetch_add(1, Ordering::Relaxed);
+        let path = directory.join(format!("{}-{id}.part", std::process::id()));
+        match OpenOptions::new().write(true).create_new(true).open(&path) {
+            Ok(file) => return Ok((StagedFile { path }, file)),
+            Err(error) if error.kind() == io::ErrorKind::AlreadyExists => continue,
+            Err(error) => return Err(error),
+        }
+    }
+}
+
+fn path_exists(path: &Path) -> io::Result<bool> {
+    match fs::symlink_metadata(path) {
+        Ok(_) => Ok(true),
+        Err(error) if error.kind() == io::ErrorKind::NotFound => Ok(false),
+        Err(error) => Err(error),
+    }
+}
+
+/// Compare path identities without changing historical database strings. Resolve
+/// existing prefixes (including symlinks), then normalize missing suffixes too.
+/// A dangling symlink cannot safely establish an identity and fails closed.
+fn path_identity(path: &Path) -> io::Result<PathBuf> {
+    let absolute = if path.is_absolute() {
+        path.to_owned()
+    } else {
+        std::env::current_dir()?.join(path)
+    };
+    let mut resolved = PathBuf::new();
+    for part in absolute.components() {
+        match part {
+            Component::RootDir | Component::Prefix(_) => resolved.push(part.as_os_str()),
+            Component::CurDir => {}
+            Component::ParentDir => { resolved.pop(); }
+            Component::Normal(name) => {
+                let next = resolved.join(name);
+                match fs::canonicalize(&next) {
+                    Ok(canonical) => resolved = canonical,
+                    Err(error) if error.kind() == io::ErrorKind::NotFound => {
+                        if fs::symlink_metadata(&next).is_ok_and(|meta| meta.file_type().is_symlink()) {
+                            return Err(io::Error::other("unresolved historical path symlink"));
+                        }
+                        resolved = next;
+                    }
+                    Err(error) => return Err(error),
+                }
+            }
+        }
+    }
+    Ok(resolved)
+}
+
+impl FlatOutput {
+    /// Serialize allocation across both Tokio tasks and local processes. The ledger
+    /// is fsynced before the caller persists page.path and starts any downloads.
+    pub fn reserve(
+        root: &Path,
+        owner: &str,
+        preferred: &str,
+        bvid: &str,
+        occupied: &HashSet<PathBuf>,
+    ) -> io::Result<Self> {
+        component(owner)?;
+        component(preferred)?;
+        component(bvid)?;
+        let root = fs::canonicalize(root)?;
+        let occupied = occupied.iter().map(|path| path_identity(path))
+            .collect::<io::Result<HashSet<_>>>()?;
+        let state = root.join(STATE_DIR);
+        let assignments = state.join("assignments");
+        fs::create_dir_all(&assignments)?;
+        // Each caller opens its own file description: the OS lock also serializes
+        // callers in this process. Unsupported locking fails closed.
+        let lock = OpenOptions::new()
+            .read(true)
+            .write(true)
+            .create(true)
+            .truncate(false)
+            .open(state.join("lock"))?;
+        lock.lock()?;
+        let record = assignments.join(owner);
+        match read_assignment(&record) {
+            Ok(name) => return Ok(Self { path: root.join(name) }),
+            Err(error) if error.kind() == io::ErrorKind::NotFound => {}
+            Err(error) => return Err(error),
+        }
+        let mut names = HashSet::new();
+        for entry in fs::read_dir(&assignments)? {
+            names.insert(read_assignment(&entry?.path())?);
+        }
+        let mut counter = 0_u64;
+        let name = loop {
+            let stem = match counter {
+                0 => preferred.to_owned(),
+                1 => format!("{preferred}_{bvid}"),
+                _ => format!("{preferred}_{bvid}_{counter}"),
+            };
+            let name = format!("{stem}.mp4");
+            let path = root.join(&name);
+            if !names.contains(&name) && !occupied.contains(&path) && !path_exists(&path)? {
+                break name;
+            }
+            counter = counter
+                .checked_add(1)
+                .ok_or_else(|| io::Error::other("flat-output names exhausted"))?;
+        };
+        let (staged, mut file) = staging_file(&state.join("staging"))?;
+        file.write_all(name.as_bytes())?;
+        file.sync_all()?;
+        // Never expose an empty or partial assignment, including after a crash.
+        fs::hard_link(staged.path(), &record)?;
+        File::open(&assignments)?.sync_all()?;
+        File::open(&state)?.sync_all()?;
+        File::open(&root)?.sync_all()?;
+        Ok(Self { path: root.join(name) })
+    }
+
+    /// Only paths created by this ledger receive the new publication semantics.
+    pub fn load(path: &Path, owner: &str) -> io::Result<Option<Self>> {
+        component(owner)?;
+        let parent = path.parent().ok_or_else(|| io::Error::other("missing output parent"))?;
+        let record = parent.join(STATE_DIR).join("assignments").join(owner);
+        match read_assignment(&record) {
+            Ok(name) if path.file_name() == Some(std::ffi::OsStr::new(&name)) => {
+                Ok(Some(Self { path: path.to_owned() }))
+            }
+            Ok(_) => Err(io::Error::other(
+                "recorded page path conflicts with flat-output assignment",
+            )),
+            Err(error) if error.kind() == io::ErrorKind::NotFound => Ok(None),
+            Err(error) => Err(error),
+        }
+    }
+
+    pub fn stage(&self) -> io::Result<StagedFile> {
+        let parent = self
+            .path
+            .parent()
+            .ok_or_else(|| io::Error::other("missing output parent"))?;
+        let (staged, _) = staging_file(&parent.join(STATE_DIR).join("staging"))?;
+        Ok(staged)
+    }
+
+    /// A same-filesystem hard link is an atomic, no-clobber publication. Retries
+    /// after publication but before the status commit succeed only for equal bytes.
+    /// We never infer successful completion merely from an existing filename.
+    pub fn publish(&self, staged: StagedFile) -> io::Result<()> {
+        File::open(staged.path())?.sync_all()?;
+        match fs::hard_link(staged.path(), &self.path) {
+            Ok(()) => {}
+            Err(error) if error.kind() == io::ErrorKind::AlreadyExists => {
+                if !equal_files(staged.path(), &self.path)? {
+                    return Err(io::Error::new(
+                        io::ErrorKind::AlreadyExists,
+                        "flat-output destination already exists with different contents",
+                    ));
+                }
+            }
+            Err(error) => return Err(error),
+        }
+        File::open(self.path.parent().unwrap())?.sync_all()?;
+        Ok(())
+    }
+}
+
+fn equal_files(left: &Path, right: &Path) -> io::Result<bool> {
+    // An unrelated symlink/directory is never accepted as a completed download.
+    if !fs::symlink_metadata(right)?.file_type().is_file() {
+        return Ok(false);
+    }
+    let mut left = File::open(left)?;
+    let mut right = File::open(right)?;
+    if left.metadata()?.len() != right.metadata()?.len() {
+        return Ok(false);
+    }
+    let mut a = [0_u8; 64 * 1024];
+    let mut b = [0_u8; 64 * 1024];
+    loop {
+        let n = left.read(&mut a)?;
+        if n == 0 {
+            return Ok(right.read(&mut b[..1])? == 0);
+        }
+        right.read_exact(&mut b[..n])?;
+        if a[..n] != b[..n] {
+            return Ok(false);
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::{Arc, Barrier};
+    use std::thread;
+
+    struct TestDir(PathBuf);
+    impl TestDir {
+        fn new() -> Self {
+            let path = std::env::temp_dir().join(format!(
+                "bili-flat-test-{}-{}",
+                std::process::id(),
+                NEXT_FILE.fetch_add(1, Ordering::Relaxed)
+            ));
+            fs::create_dir(&path).unwrap();
+            Self(path)
+        }
+        fn reserve(&self, owner: &str) -> FlatOutput {
+            FlatOutput::reserve(&self.0, owner, "UP_Title", "BVexample", &HashSet::new()).unwrap()
+        }
+    }
+    impl Drop for TestDir {
+        fn drop(&mut self) {
+            fs::remove_dir_all(&self.0).unwrap();
+        }
+    }
+    fn publish(output: &FlatOutput, bytes: &[u8]) -> io::Result<()> {
+        let staged = output.stage()?;
+        fs::write(staged.path(), bytes)?;
+        output.publish(staged)
+    }
+
+    #[test]
+    fn concurrent_pages_keep_pretty_names_and_never_overwrite() {
+        let dir = TestDir::new();
+        let barrier = Arc::new(Barrier::new(24));
+        let handles: Vec<_> = (0..24)
+            .map(|index| {
+                let root = dir.0.clone();
+                let barrier = Arc::clone(&barrier);
+                thread::spawn(move || {
+                    barrier.wait();
+                    let output = FlatOutput::reserve(
+                        &root,
+                        &format!("page-{index}"),
+                        "UP_Title",
+                        "BVexample",
+                        &HashSet::new(),
+                    )
+                    .unwrap();
+                    publish(&output, format!("page-{index}").as_bytes()).unwrap();
+                    assert_eq!(fs::read_to_string(&output.path).unwrap(), format!("page-{index}"));
+                    output.path
+                })
+            })
+            .collect();
+        let paths: HashSet<_> = handles.into_iter().map(|h| h.join().unwrap()).collect();
+        assert_eq!(paths.len(), 24);
+        assert!(paths.contains(&dir.0.join("UP_Title.mp4")));
+        assert!(paths.contains(&dir.0.join("UP_Title_BVexample.mp4")));
+    }
+
+    #[test]
+    fn reservation_survives_crash_before_database_write_and_title_change() {
+        let dir = TestDir::new();
+        let first = dir.reserve("page-1");
+        let retry = FlatOutput::reserve(&dir.0, "page-1", "Renamed", "BVexample", &HashSet::new()).unwrap();
+        assert_eq!(first.path, retry.path);
+        assert!(!first.path.exists());
+    }
+
+    #[test]
+    fn historical_missing_file_aliases_reserve_the_same_target() {
+        let dir = TestDir::new();
+        fs::create_dir(dir.0.join("child")).unwrap();
+        let occupied = HashSet::from([dir.0.join("child/../UP_Title.mp4")]);
+        let output = FlatOutput::reserve(&dir.0, "page-1", "UP_Title", "BVexample", &occupied).unwrap();
+        assert_eq!(output.path, dir.0.join("UP_Title_BVexample.mp4"));
+        assert!(occupied.contains(&dir.0.join("child/../UP_Title.mp4")));
+    }
+
+    #[test]
+    fn historical_missing_parent_suffix_is_normalized() {
+        let dir = TestDir::new();
+        let occupied = HashSet::from([dir.0.join("missing/../UP_Title.mp4")]);
+        let output = FlatOutput::reserve(&dir.0, "page-1", "UP_Title", "BVexample", &occupied).unwrap();
+        assert_eq!(output.path, dir.0.join("UP_Title_BVexample.mp4"));
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn historical_symlink_parent_aliases_reserve_the_target() {
+        let dir = TestDir::new();
+        std::os::unix::fs::symlink(&dir.0, dir.0.join("alias")).unwrap();
+        let occupied = HashSet::from([dir.0.join("alias/UP_Title.mp4")]);
+        let output = FlatOutput::reserve(&dir.0, "page-1", "UP_Title", "BVexample", &occupied).unwrap();
+        assert_eq!(output.path, dir.0.join("UP_Title_BVexample.mp4"));
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn unresolved_historical_symlink_fails_closed() {
+        let dir = TestDir::new();
+        std::os::unix::fs::symlink(dir.0.join("absent"), dir.0.join("alias")).unwrap();
+        let occupied = HashSet::from([dir.0.join("alias/UP_Title.mp4")]);
+        assert!(FlatOutput::reserve(&dir.0, "page-1", "UP_Title", "BVexample", &occupied).is_err());
+    }
+
+    #[test]
+    fn retry_after_publication_before_status_commit_reuses_assignment() {
+        let dir = TestDir::new();
+        let first = dir.reserve("page-1");
+        publish(&first, b"complete media").unwrap();
+        let retry = dir.reserve("page-1");
+        assert_eq!(first.path, retry.path);
+        publish(&retry, b"complete media").unwrap();
+        assert_eq!(fs::read(&first.path).unwrap(), b"complete media");
+        assert_eq!(fs::read_dir(dir.0.join(STATE_DIR).join("staging")).unwrap().count(), 0);
+    }
+
+    #[test]
+    fn abandoned_partial_download_never_becomes_final() {
+        let dir = TestDir::new();
+        let first = dir.reserve("page-1");
+        let abandoned = first.stage().unwrap();
+        fs::write(abandoned.path(), b"partial").unwrap();
+        std::mem::forget(abandoned); // Simulate process death before publication.
+        assert!(!first.path.exists());
+        publish(&dir.reserve("page-1"), b"complete").unwrap();
+        assert_eq!(fs::read(&first.path).unwrap(), b"complete");
+    }
+
+    #[test]
+    fn preexisting_and_persisted_but_missing_paths_are_excluded() {
+        let dir = TestDir::new();
+        fs::write(dir.0.join("UP_Title.mp4"), b"historical").unwrap();
+        let missing = dir.0.join("UP_Title_BVexample.mp4");
+        let occupied = HashSet::from([missing.clone()]);
+        let output = FlatOutput::reserve(&dir.0, "page-1", "UP_Title", "BVexample", &occupied).unwrap();
+        assert_eq!(output.path, dir.0.join("UP_Title_BVexample_2.mp4"));
+        assert_eq!(fs::read(dir.0.join("UP_Title.mp4")).unwrap(), b"historical");
+        assert!(!missing.exists());
+    }
+
+    #[test]
+    fn unrelated_target_appearing_after_reservation_is_not_overwritten() {
+        let dir = TestDir::new();
+        let output = dir.reserve("page-1");
+        fs::write(&output.path, b"other content").unwrap();
+        assert_eq!(
+            publish(&output, b"my video").unwrap_err().kind(),
+            io::ErrorKind::AlreadyExists
+        );
+        assert_eq!(fs::read(&output.path).unwrap(), b"other content");
+    }
+
+    #[test]
+    fn historical_paths_are_not_adopted_or_renamed() {
+        let dir = TestDir::new();
+        let old = dir.0.join("Old title - S01E02.mp4");
+        assert!(FlatOutput::load(&old, "page-1").unwrap().is_none());
+        let output = dir.reserve("page-1");
+        assert_eq!(
+            FlatOutput::load(&output.path, "page-1").unwrap().unwrap().path,
+            output.path
+        );
+        assert!(FlatOutput::load(&old, "page-1").is_err());
+    }
+
+    #[test]
+    fn concurrent_retries_for_same_page_share_one_assignment() {
+        let dir = TestDir::new();
+        let handles: Vec<_> = (0..12)
+            .map(|_| {
+                let root = dir.0.clone();
+                thread::spawn(move || {
+                    let output =
+                        FlatOutput::reserve(&root, "page-1", "UP_Title", "BVexample", &HashSet::new()).unwrap();
+                    publish(&output, b"same media").unwrap();
+                    output.path
+                })
+            })
+            .collect();
+        let paths: HashSet<_> = handles.into_iter().map(|h| h.join().unwrap()).collect();
+        assert_eq!(paths.len(), 1);
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn dangling_symlink_is_a_collision_and_cannot_be_published_over() {
+        let dir = TestDir::new();
+        std::os::unix::fs::symlink("missing", dir.0.join("UP_Title.mp4")).unwrap();
+        let output = dir.reserve("page-1");
+        assert_eq!(output.path, dir.0.join("UP_Title_BVexample.mp4"));
+        std::os::unix::fs::symlink("missing", &output.path).unwrap();
+        assert!(publish(&output, b"video").is_err());
+        assert!(fs::symlink_metadata(&output.path).unwrap().file_type().is_symlink());
+    }
+    #[test]
+    fn lock_holder_subprocess() {
+        let Ok(root) = std::env::var("BILI_FLAT_TEST_LOCK_ROOT") else {
+            return;
+        };
+        let lock = OpenOptions::new()
+            .read(true)
+            .write(true)
+            .create(true)
+            .truncate(false)
+            .open(Path::new(&root).join(STATE_DIR).join("lock"))
+            .unwrap();
+        lock.lock().unwrap();
+        fs::write(Path::new(&root).join("ready"), b"locked").unwrap();
+        loop {
+            thread::sleep(std::time::Duration::from_secs(1));
+        }
+    }
+
+    #[test]
+    fn process_death_releases_lock_without_deleting_reservations() {
+        let dir = TestDir::new();
+        let first = dir.reserve("page-1");
+        let mut child = std::process::Command::new(std::env::current_exe().unwrap())
+            .args(["lock_holder_subprocess", "--test-threads=1"])
+            .env("BILI_FLAT_TEST_LOCK_ROOT", &dir.0)
+            .stdout(std::process::Stdio::null())
+            .spawn()
+            .unwrap();
+        let deadline = std::time::Instant::now() + std::time::Duration::from_secs(10);
+        while !dir.0.join("ready").exists() && std::time::Instant::now() < deadline {
+            thread::sleep(std::time::Duration::from_millis(10));
+        }
+        let ready = dir.0.join("ready").exists();
+        child.kill().unwrap();
+        child.wait().unwrap();
+        assert!(ready, "child did not acquire the lock");
+        assert_eq!(dir.reserve("page-1").path, first.path);
+        assert_ne!(dir.reserve("page-2").path, first.path);
+    }
+
+    #[test]
+    fn corrupted_ledger_fails_closed() {
+        let dir = TestDir::new();
+        let output = dir.reserve("page-1");
+        fs::write(dir.0.join(STATE_DIR).join("assignments/page-1"), b"../../outside.mp4").unwrap();
+        assert!(FlatOutput::load(&output.path, "page-1").is_err());
+        assert!(FlatOutput::reserve(&dir.0, "page-2", "UP_Title", "BVexample", &HashSet::new()).is_err());
+    }
+}
