[Unit]
Description=Generate the monthly ShellCrash proxy usage HTML report
After=shellcrash-traffic-collector.service

[Service]
Type=oneshot
User=shellcrash
Group=Users
ExecStart=/home/yuwk/cron/scripts/shellcrash-traffic-report --html /var/lib/shellcrash-traffic/report.html
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths=/var/lib/shellcrash-traffic
