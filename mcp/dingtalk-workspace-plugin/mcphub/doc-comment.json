{
  "name": "dingtalk-doc-comment",
  "config": {
    "type": "streamable-http",
    "url": "https://mcp-gw.dingtalk.com/oauth/server/doc-comment",
    "description": "钉钉文档评论与批注",
    "enabled": true,
    "oauth": {
      "scopes": [
        "user"
      ],
      "dynamicRegistration": {
        "enabled": true,
        "metadata": {
          "client_name": "MCPHub - 钉钉文档评论",
          "token_endpoint_auth_method": "client_secret_post"
        }
      }
    },
    "tools": {
      "batch_query_comments": {
        "enabled": true
      },
      "create_comment": {
        "enabled": true
      },
      "create_file_comment": {
        "enabled": true
      },
      "create_inline_comment": {
        "enabled": true
      },
      "create_sheet_comment": {
        "enabled": true
      },
      "delete_comment": {
        "enabled": true
      },
      "list_comments": {
        "enabled": true
      },
      "list_file_comments": {
        "enabled": true
      },
      "list_replies": {
        "enabled": true
      },
      "list_sheet_comments": {
        "enabled": true
      },
      "reply_comment": {
        "enabled": true
      },
      "resolve_comment": {
        "enabled": true
      },
      "restore_comment": {
        "enabled": true
      },
      "update_comment": {
        "enabled": true
      }
    }
  }
}
