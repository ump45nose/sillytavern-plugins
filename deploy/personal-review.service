[Unit]
Description=Personal Review private HTTP
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hermes
Group=hermes
WorkingDirectory=/vol2/1000/Docker/personal-review
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/vol2/1000/Docker/personal-review/bin/reviewctl serve --host 192.168.31.201 --port 18191 --token-hash-file /home/yuwk/.config/personal-review/http-token.sha256
Restart=on-failure
RestartSec=5
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/vol2/1000/Docker/personal-review/state /vol2/1000/Docker/personal-review/logs

[Install]
WantedBy=multi-user.target
