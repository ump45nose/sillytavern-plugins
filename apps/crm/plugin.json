{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "personal-crm",
  "version": "2.0.0",
  "description": "维护人物基本资料与多人交互历史，支持查询、录入、编辑和附件。微信私聊按连续对话归档。",
  "author": {
    "name": "yuwk"
  },
  "repository": "https://github.com/ump45nose/personal-data-hub",
  "keywords": [
    "CRM",
    "联系人",
    "交互历史",
    "微信"
  ],
  "extensions": {
    "com.openai": {
      "apps": "./.app.json",
      "interface": {
        "displayName": "CRM",
        "shortDescription": "维护人物资料与交互历史",
        "longDescription": "维护人物基本资料与多人交互历史，支持查询、录入、编辑和附件。微信私聊按连续对话归档。",
        "developerName": "yuwk",
        "category": "Productivity",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://github.com/ump45nose/personal-data-hub",
        "defaultPrompt": [
          "查找张三，读取最近一个月的交互。",
          "记录我、张三和李四今天一起吃饭。",
          "修改某次交互的正文，附上文件。"
        ],
        "brandColor": "#5953C8",
        "logo": "./assets/plugin/logo-c.png",
        "composerIcon": "./assets/plugin/logo-c.png"
      }
    }
  }
}
