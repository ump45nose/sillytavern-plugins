[Unit]
Description=Health Webhook Receiver (FastAPI/uvicorn) - 2026-07-17
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hermes
Group=hermes
WorkingDirectory=/home/hermes/.local/share/health-webhook
ExecStart=/home/hermes/.hermes/hermes-agent/venv/bin/python -m uvicorn app:app --app-dir /home/hermes/.local/share/health-webhook --host 0.0.0.0 --port 8765
Restart=on-failure
RestartSec=5
EnvironmentFile=/home/hermes/.hermes/.env
EnvironmentFile=/home/hermes/.hermes/profiles/lingjun/.env

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/hermes/.local/share

[Install]
WantedBy=multi-user.target
