<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.yuwk.personal-review-skysight</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Library/Developer/CommandLineTools/Library/Frameworks/Python3.framework/Versions/3.9/bin/python3</string>
		<string>/Users/yuwk/Library/Application Support/PersonalReview/run-skysight.py</string>
		<string>/Applications/ChatGPT.app/Contents/Resources/cua_node/bin/node</string>
		<string>/Users/yuwk/Library/Application Support/PersonalReview/sync-skysight.mjs</string>
		<string>--host</string>
		<string>nas</string>
		<string>--repair-count-mismatch</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>/Users/yuwk</string>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>21</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>StandardOutPath</key>
	<string>/Users/yuwk/Library/Logs/PersonalReview/skysight-sync.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/yuwk/Library/Logs/PersonalReview/skysight-sync.error.log</string>
	<key>StartInterval</key>
	<integer>600</integer>
</dict>
</plist>
