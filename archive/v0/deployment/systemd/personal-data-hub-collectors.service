[Unit]
Description=Personal information collectors (archive only)
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=yuwk
Group=Users
WorkingDirectory=/home/yuwk/code/personal-data-hub
ExecStart=/home/yuwk/code/personal-data-hub/.venv/bin/hub serve-collectors
Restart=on-failure
RestartSec=10
UMask=0077
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
