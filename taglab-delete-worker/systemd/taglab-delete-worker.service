[Unit]
Description=TagLab one-shot music cleanup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=yuwk
Group=Users
WorkingDirectory=/home/yuwk/cron/scripts
EnvironmentFile=/home/yuwk/cron/env/taglab-delete-worker.env
ExecStart=/usr/bin/python3 /home/yuwk/cron/scripts/taglab-delete-worker.py --once
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/yuwk/cron
ReadWritePaths=/vol1/1000/Music
