HOST=0.0.0.0
PORT=8080
CRM_BIND_ADDRESS=127.0.0.1
CRM_HOST_PORT=8080
DATABASE_URL=sqlite:////data/personal-crm.db
WECHAT_WEBHOOK_SECRET=replace-with-a-long-random-secret

# 公网 MCP：复用 SmartSearch 的 Authelia OIDCProxy 模式
PUBLIC_BASE_URL=
OIDC_DISCOVERY_URL=https://authelia.example.com/.well-known/openid-configuration
OIDC_CLIENT_ID=personal-crm
OIDC_CLIENT_SECRET=
OIDC_AUTHORIZED_USERNAMES=
# 可选：白名单中只能读取、不能修改 CRM 的 Authelia 用户名
OIDC_READ_ONLY_USERNAMES=
OAUTH_JWT_SIGNING_KEY=
OAUTH_STORAGE_ENCRYPTION_KEY=
OAUTH_STORAGE_PATH=/data/oauth
# 允许本机 Agent，以及 GPT、Claude、Grok 官方主域名和全部子域名回调。
ALLOWED_CLIENT_REDIRECT_URIS=http://localhost:*,http://127.0.0.1:*,https://chatgpt.com/*,https://*.chatgpt.com/*,https://openai.com/*,https://*.openai.com/*,https://claude.ai/*,https://*.claude.ai/*,https://anthropic.com/*,https://*.anthropic.com/*,https://grok.com/*,https://*.grok.com/*,https://x.ai/*,https://*.x.ai/*,https://x.com/*,https://*.x.com/*
CRM_ASSET_ROOT=/hub-assets
WECHAT_INTERACTION_GAP_MINUTES=30
HUB_API_TOKEN=
HUB_VIEWER_TOKEN=

# 只读数据源（生产由 mcp.app.yaml 挂载），Memos 保留同目录 WAL/SHM。
CODEX_SKYLIGHT_PATH=/sources/codex-skylight
# 每日 23:00（北京时间）分别推送 Skylight、Memos 事件，需已授权 OAuth 用户。
DAILY_REVIEW_EVENTS_ENABLED=false
DAILY_REVIEW_EVENT_OWNER=
DAILY_REVIEW_EVENT_STORAGE_PATH=/data/events/daily-reviews
DAILY_REVIEW_EVENT_TIMEZONE=Asia/Shanghai
DAILY_REVIEW_EVENT_TIME=23:00
DAILY_REVIEW_EVENT_POLL_SECONDS=60

# 无认证开发模式必须显式开启，且 HOST 只能是回环地址
MCP_DEVELOPMENT_NO_AUTH=false
MCP_PROXY_SNI_COMPATIBILITY=false
