# 私聊采集器在已获授权的 Mac 上运行；使用现有 chatlog-keeper 读取器。
CHATLOG_EXECUTABLE=/absolute/path/to/chatlog-keeper
CRM_WEBHOOK_URL=http://127.0.0.1:8080/api/v1/crm/ingest/wechat
CRM_WEBHOOK_TOKEN=
CRM_CLIENT_ID=my-mac
CRM_ACCOUNT_NAMESPACE=
CRM_CHECKPOINT=connector-state/checkpoint.json
CHATLOG_POLL_SECONDS=60
CHATLOG_TIMEOUT=120
WECHAT_MEDIA_ENABLED=false
WECHAT_MEDIA_QUEUE=connector-state/media-queue.json
