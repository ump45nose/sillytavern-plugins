#!/usr/bin/env python3
"""Renew the two qBittorrent peer-port mappings on the local ZTE router."""

from __future__ import annotations

import socket
import urllib.error
import urllib.request
import xml.etree.ElementTree as ET


ROUTER_IP = "192.168.31.1"
INTERNAL_IP = "192.168.31.201"
PORTS = (16881,)
SERVICE_TYPE = "urn:schemas-upnp-org:service:WANIPConnection:1"
MIN_REMAINING_LEASE = 3 * 24 * 60 * 60


def discover_description() -> str:
    message = (
        "M-SEARCH * HTTP/1.1\r\n"
        "HOST: 239.255.255.250:1900\r\n"
        'MAN: "ssdp:discover"\r\n'
        "MX: 2\r\n"
        "ST: urn:schemas-upnp-org:device:InternetGatewayDevice:1\r\n\r\n"
    ).encode()
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM, socket.IPPROTO_UDP)
    sock.settimeout(4)
    sock.sendto(message, ("239.255.255.250", 1900))
    while True:
        payload, address = sock.recvfrom(65535)
        if address[0] != ROUTER_IP:
            continue
        for line in payload.decode("utf-8", "replace").splitlines():
            if line.lower().startswith("location:"):
                return line.split(":", 1)[1].strip()


def control_url(description_url: str) -> str:
    root = ET.fromstring(urllib.request.urlopen(description_url, timeout=5).read())
    namespace = {"u": "urn:schemas-upnp-org:device-1-0"}
    for service in root.findall(".//u:service", namespace):
        service_type = service.findtext("u:serviceType", namespaces=namespace)
        if service_type == SERVICE_TYPE:
            path = service.findtext("u:controlURL", namespaces=namespace)
            if path:
                return "/".join(description_url.split("/", 3)[:3]) + path
    raise RuntimeError("WANIPConnection control URL not found")


def soap(control: str, action: str, inner: str) -> bytes:
    envelope = (
        '<?xml version="1.0"?>'
        '<s:Envelope xmlns:s="http://schemas.xmlsoap.org/soap/envelope/" '
        's:encodingStyle="http://schemas.xmlsoap.org/soap/encoding/">'
        f'<s:Body><u:{action} xmlns:u="{SERVICE_TYPE}">{inner}'
        f"</u:{action}></s:Body></s:Envelope>"
    ).encode()
    request = urllib.request.Request(
        control,
        data=envelope,
        headers={
            "SOAPAction": f'"{SERVICE_TYPE}#{action}"',
            "Content-Type": 'text/xml; charset="utf-8"',
        },
    )
    return urllib.request.urlopen(request, timeout=5).read()


def mapping(control: str, port: int, protocol: str) -> dict[str, str] | None:
    try:
        response = soap(
            control,
            "GetSpecificPortMappingEntry",
            "<NewRemoteHost></NewRemoteHost>"
            f"<NewExternalPort>{port}</NewExternalPort>"
            f"<NewProtocol>{protocol}</NewProtocol>",
        )
    except urllib.error.HTTPError as error:
        if error.code == 500:
            return None
        raise
    root = ET.fromstring(response)
    return {element.tag.split("}")[-1]: element.text or "" for element in root.iter()}


def delete_mapping(control: str, port: int, protocol: str) -> None:
    soap(
        control,
        "DeletePortMapping",
        "<NewRemoteHost></NewRemoteHost>"
        f"<NewExternalPort>{port}</NewExternalPort>"
        f"<NewProtocol>{protocol}</NewProtocol>",
    )


def add_mapping(control: str, port: int, protocol: str) -> None:
    soap(
        control,
        "AddPortMapping",
        "<NewRemoteHost></NewRemoteHost>"
        f"<NewExternalPort>{port}</NewExternalPort>"
        f"<NewProtocol>{protocol}</NewProtocol>"
        f"<NewInternalPort>{port}</NewInternalPort>"
        f"<NewInternalClient>{INTERNAL_IP}</NewInternalClient>"
        "<NewEnabled>1</NewEnabled>"
        f"<NewPortMappingDescription>qBittorrent-{port}</NewPortMappingDescription>"
        "<NewLeaseDuration>0</NewLeaseDuration>",
    )


def main() -> None:
    control = control_url(discover_description())
    for port in PORTS:
        for protocol in ("TCP", "UDP"):
            current = mapping(control, port, protocol)
            if current:
                target = current.get("NewInternalClient")
                internal_port = current.get("NewInternalPort")
                enabled = current.get("NewEnabled")
                if (target, internal_port, enabled) != (INTERNAL_IP, str(port), "1"):
                    raise RuntimeError(
                        f"refusing to replace conflicting {protocol}/{port} mapping"
                    )
                lease = int(current.get("NewLeaseDuration") or "0")
                if lease == 0 or lease > MIN_REMAINING_LEASE:
                    print(f"healthy {protocol}/{port}, lease={lease}s")
                    continue
                delete_mapping(control, port, protocol)
            add_mapping(control, port, protocol)
            renewed = mapping(control, port, protocol)
            if not renewed or renewed.get("NewInternalClient") != INTERNAL_IP:
                raise RuntimeError(f"failed to verify {protocol}/{port} mapping")
            print(
                f"renewed {protocol}/{port} -> {INTERNAL_IP}:{port}, "
                f"lease={renewed.get('NewLeaseDuration')}s"
            )


if __name__ == "__main__":
    main()
