HOST=0.0.0.0
PORT=8080
DATABASE_URL=sqlite:////data/personal-crm.db
WECHAT_WEBHOOK_SECRET=replace-with-a-long-random-secret

# 公网 MCP：以下三项同时存在时启用 GitHub OAuth
PUBLIC_BASE_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ALLOWED_USER_IDS=
# 可选：白名单中只能读取、不能修改 CRM 的 GitHub 数字用户 ID
GITHUB_READ_ONLY_USER_IDS=
OAUTH_JWT_SIGNING_KEY=
ALLOWED_CLIENT_REDIRECT_URIS=http://localhost:*,http://127.0.0.1:*
