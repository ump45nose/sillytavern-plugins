# 默认只监听本机；独立数据目录不依赖 Hub。
HOST=127.0.0.1
PORT=8080
DATABASE_URL=postgresql+psycopg://crm:password@localhost/crm
CRM_ASSET_ROOT=data/attachments
WECHAT_INTERACTION_GAP_MINUTES=30

# HTTP：分别设置随机读写令牌和可选只读令牌；空令牌不接受请求。
CRM_API_TOKEN=
CRM_VIEWER_TOKEN=
WECHAT_WEBHOOK_SECRET=

# 仅本机开发可使用无 OAuth MCP。公网部署设 false 并填写下面的 OAuth 配置。
MCP_DEVELOPMENT_NO_AUTH=true
PUBLIC_BASE_URL=
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=personal-crm
OIDC_CLIENT_SECRET=
OIDC_AUTHORIZED_USERNAMES=
OIDC_READ_ONLY_USERNAMES=
OAUTH_JWT_SIGNING_KEY=
OAUTH_STORAGE_ENCRYPTION_KEY=
OAUTH_STORAGE_PATH=data/oauth
MCP_PROXY_SNI_COMPATIBILITY=false
